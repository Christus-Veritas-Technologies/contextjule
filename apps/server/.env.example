# --- core -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/contextjule
CORS_ORIGIN=http://localhost:3001
SERVER_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# --- Dodo Payments ----------------------------------------------------------
# Dashboard -> Developer -> API keys
DODO_API_KEY=
# Dashboard -> Developer -> Webhooks -> signing secret
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
# The one product, with a License Key entitlement attached.
#
# There are no discount codes. This product's PRICE is the price, and you edit
# it by hand as the launch moves:
#
#   free run     set the price so the first hundred pay nothing
#   next 72h     $4.99
#   after that   $14.99
#
# The site reads which phase it is in from the Promo row, not from Dodo, so
# change the price and the phase together.
DODO_PRODUCT_ID=

# --- email (SMTP, via nodemailer) -------------------------------------------
# Any SMTP provider. Port 465 is implicit TLS; anything else uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Only set this if your provider disagrees with the port convention above.
SMTP_SECURE=
EMAIL_FROM=ContextJule <hello@contextjule.com>
EMAIL_REPLY_TO=
# Skip sending and print the payload instead. Leave on locally.
EMAIL_DRY_RUN=true

# --- downloads --------------------------------------------------------------
# 32+ chars. Rotating this invalidates every outstanding download link.
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
DOWNLOAD_SIGNING_SECRET=
ARTIFACT_BASE_URL=
FREE_CLAIM_IP_LIMIT=5

# --- publishing -------------------------------------------------------------
# Bearer token for POST /api/releases, called by the release workflow. 32+ chars.
# The same value goes in the CONTEXTJULE_ADMIN_TOKEN GitHub secret.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
