# --- core -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/contextjule
CORS_ORIGIN=http://localhost:3001
SERVER_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# --- Dodo Payments ----------------------------------------------------------
# Dashboard -> Developer -> API keys
DODO_API_KEY=
# Dashboard -> Developer -> Webhooks -> signing secret
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
# The one product, with a License Key entitlement attached
DODO_PRODUCT_ID=
# Discount codes. The free one is 100% off with a usage limit — that cap IS the
# protection on a free promotion, so set it deliberately.
DODO_LAUNCH_DISCOUNT_CODE=
DODO_FREE_DISCOUNT_CODE=

# --- email ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=ContextJule <hello@contextjule.com>
EMAIL_DRY_RUN=true

# --- downloads --------------------------------------------------------------
# 32+ chars. Rotating this invalidates every outstanding download link.
DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-string-please
ARTIFACT_BASE_URL=
FREE_CLAIM_IP_LIMIT=3

# --- publishing -------------------------------------------------------------
# Bearer token for POST /api/releases, called by the release workflow. 32+ chars.
# Leave blank locally: the endpoint returns 503 rather than defaulting to
# something guessable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
