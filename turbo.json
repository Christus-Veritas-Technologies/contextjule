{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "db:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": { "cache": false, "interactive": true },
    "db:generate": {
      "cache": false,
      "inputs": ["prisma/schema/**"],
      "outputs": ["prisma/generated/**"]
    },
    "db:migrate": { "cache": false, "interactive": true },
    "db:seed": { "cache": false, "interactive": true },
    "db:studio": { "cache": false, "persistent": true }
  }
}
