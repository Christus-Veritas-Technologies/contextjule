enum LicenseKeyStatus {
  active
  expired
  disabled
  revoked
}

/// A license key issued by Dodo on purchase. This row is a mirror: Dodo remains
/// the source of truth for validity, and the desktop app can validate against
/// Dodo's public endpoint with no server of ours in the path. We keep it so
/// support can answer "which key does this person hold" without a dashboard.
model LicenseKey {
  id               String           @id @default(cuid())
  dodoLicenseKeyId String?          @unique
  /// The key itself, as the customer sees it.
  key              String           @unique
  status           LicenseKeyStatus @default(active)
  customerId       String
  productId        String?
  paymentId        String?
  /// Concurrent machines allowed. Null means unlimited.
  activationsLimit Int?
  activationsUsed  Int              @default(0)
  expiresAt        DateTime?

  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  payment     Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  activations LicenseActivation[]
  grant       EntitlementGrant?
  downloads   DownloadToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

/// One machine running one key. Dodo calls this an instance; we key it by our
/// own stable machine id as well, so reinstalling on the same computer reuses
/// the activation instead of burning a slot.
model LicenseActivation {
  id             String    @id @default(cuid())
  licenseKeyId   String
  /// Dodo's `license_key_instance_id`, returned by /licenses/activate.
  dodoInstanceId String?   @unique
  /// Stable per-machine identifier generated by the desktop app.
  machineId      String
  deviceName     String?
  platform       String?
  appVersion     String?
  activatedAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  deactivatedAt  DateTime?

  licenseKey LicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)

  /// One row per key per machine, so a reinstall updates rather than inserts.
  @@unique([licenseKeyId, machineId])
  @@index([lastSeenAt])
}

enum GrantStatus {
  pending
  delivered
  revoked
}

/// Dodo's entitlement grant, the record that ties a purchase to a key. A
/// `pending` grant means manual fulfilment is expected from us.
model EntitlementGrant {
  id              String      @id @default(cuid())
  dodoGrantId     String      @unique
  status          GrantStatus @default(pending)
  integrationType String      @default("license_key")
  customerId      String?
  licenseKeyId    String?     @unique
  deliveredAt     DateTime?
  revokedAt       DateTime?
  raw             Json?

  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  licenseKey LicenseKey? @relation(fields: [licenseKeyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
